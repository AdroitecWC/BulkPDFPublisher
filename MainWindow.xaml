<Window x:Class="CreoPublisherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CreoPublisherApp"
        Title="Bulk PDF Publisher" Height="750" Width="1000"
        WindowState="Maximized"
         ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource ForegroundColor}"
       >
    <Window.Resources>
        <!-- Light Theme Resources (Default) -->
        <SolidColorBrush x:Key="BackgroundColor" Color="White"/>
        <SolidColorBrush x:Key="ForegroundColor" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#2E3A59"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#5A9AF2"/>
        <SolidColorBrush x:Key="ButtonPressedBackground" Color="#3A80D2"/>
        <SolidColorBrush x:Key="TextBoxBackground" Color="#FFFDFDFA"/>
        <SolidColorBrush x:Key="TextBoxForeground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="DarkGray"/>
        <SolidColorBrush x:Key="SearchTextBoxBackground" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="LogTextBoxBackground" Color="#FFFBFBFB"/>
        <SolidColorBrush x:Key="LogTextBoxBorderBrush" Color="DarkSlateGray"/>
        <SolidColorBrush x:Key="FilterTextBoxBackground" Color="#FFF8F8F8"/>
        <SolidColorBrush x:Key="DataGridBackground" Color="White"/>
        <SolidColorBrush x:Key="DataGridAlternatingBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#2E3A59"/>
        <SolidColorBrush x:Key="DataGridHeaderForeground" Color="White"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2E3A59"/>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DatePickerBackground" Color="White"/>
        <SolidColorBrush x:Key="DatePickerForeground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TitleForeground" Color="#2E3A59"/>
        <SolidColorBrush x:Key="PaginationBorderBackground" Color="White"/>
        <SolidColorBrush x:Key="PaginationBorderBrush" Color="#2E3A59"/>
        <SolidColorBrush x:Key="OverlayBackground" Color="#AA000000"/>

        <!-- Dark Theme Resources -->
        <SolidColorBrush x:Key="DarkBackgroundColor" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DarkForegroundColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DarkButtonBackground" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="DarkButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="DarkButtonHoverBackground" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="DarkButtonPressedBackground" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="DarkTextBoxBackground" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="DarkTextBoxForeground" Color="White"/>
        <SolidColorBrush x:Key="DarkTextBoxBorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="DarkSearchTextBoxBackground" Color="#333333"/>
        <SolidColorBrush x:Key="DarkLogTextBoxBackground" Color="#252525"/>
        <SolidColorBrush x:Key="DarkLogTextBoxBorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="DarkFilterTextBoxBackground" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="DarkDataGridBackground" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="DarkDataGridAlternatingBackground" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="DarkDataGridHeaderBackground" Color="#404040"/>
        <SolidColorBrush x:Key="DarkDataGridHeaderForeground" Color="White"/>
        <SolidColorBrush x:Key="DarkBorderBrushColor" Color="#555555"/>
        <SolidColorBrush x:Key="DarkComboBoxBackground" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="DarkComboBoxBorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="DarkComboBoxForeground" Color="White"/>
        <SolidColorBrush x:Key="DarkDatePickerBackground" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="DarkDatePickerForeground" Color="White"/>
        <SolidColorBrush x:Key="DarkTitleForeground" Color="#87CEEB"/>
        <SolidColorBrush x:Key="DarkPaginationBorderBackground" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="DarkPaginationBorderBrush" Color="#87CEEB"/>
        <SolidColorBrush x:Key="DarkOverlayBackground" Color="#AA1E1E1E"/>

        <!-- Style for TextBoxes with dynamic theming -->
        <Style x:Key="FilePathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Search TextBox -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FilePathTextBoxStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SearchTextBoxBackground}"/>
        </Style>

        <!-- Style for Log TextBox (multiline) -->
        <Style x:Key="LogTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LogTextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource LogTextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page Number TextBox -->
        <Style x:Key="PageNumberTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FilePathTextBoxStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Filter Field TextBoxes -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FilePathTextBoxStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource FilterTextBoxBackground}"/>
            <Setter Property="Margin" Value="4,2,4,2"/>
        </Style>

        <!-- Rounded Button Style with dynamic theming -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="20"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Button Style for Navigation with dynamic theming -->
        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#2E3A59"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E4A69"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E2A49"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#28282B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            BorderBrush="Transparent"
                            BorderThickness="1"/>
                            <Ellipse x:Name="SwitchKnob"
                             Width="18" Height="18"
                             Fill="White"
                             Margin="3"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0"
                                      RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Toggle Switch Style for CheckBox -->
        <Style x:Key="ToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <!-- Toggle background -->
                            <Border x:Name="SwitchBorder"
                                    Background="#28282B"
                                    CornerRadius="14"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"/>

                            <!-- Toggle knob with icon -->
                            <Grid x:Name="KnobContainer"
                                  Width="20" Height="20"
                                  Margin="4"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                                <Ellipse Fill="White" StrokeThickness="0"/>

                                <!-- PDF Icon -->
                                <Image x:Name="PdfIcon"
                                       Source="Resources/pdf_icon.png"
                                       Width="10" Height="10"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- Centered label (optional) -->
                            <TextBlock x:Name="SwitchLabel"
                                       Text="{TemplateBinding Content}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="KnobContainer" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="PdfIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styling with dynamic theming -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource DataGridBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAlternatingBackground}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForeground}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid Row Style with dynamic theming -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource DataGridBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        </Style>

        <!-- DataGrid Cell Style with dynamic theming -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ComboBox with dynamic theming -->
        <Style x:Key="MinimalComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBoxItem Style with dynamic theming -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <!-- DatePicker Style with dynamic theming -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource DatePickerBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DatePickerForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
        </Style>

        <!-- TextBlock Styles for dynamic theming -->
        <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TitleForeground}"/>
        </Style>

        <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        </Style>

        <!-- Border styles with dynamic theming -->
        <Style x:Key="DataGridBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Background" Value="{DynamicResource DataGridBackground}"/>
        </Style>

        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DatePickerBackground}"/>
        </Style>

        <!-- Pagination Border Style -->
        <Style x:Key="PaginationBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PaginationBorderBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PaginationBorderBrush}"/>
        </Style>

        <!-- Animations -->
        <Storyboard x:Key="FadeInOverlay">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="FadeOutOverlay">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="PulseOverlay" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1" Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="20" AllowDrop="True"
          DragEnter="Grid_DragEnter"
          DragLeave="Grid_DragLeave"
          Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Bar with Title and Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Input Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Pagination and Action Buttons -->
            <RowDefinition Height="120"/>
            <!-- Log -->
        </Grid.RowDefinitions>

        <!-- Top bar with title and controls -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title with dynamic theming -->
            <TextBlock Grid.Column="0" 
                       Text="Bulk PDF Publisher" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TitleForeground}" 
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Right side controls -->
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Settings Button -->
                <Button Width="40" Height="40" 
                        ToolTip="Open export and application settings." 
                        Command="{Binding OpenSettingsWindowCommand}"
                        Style="{StaticResource CircularButtonStyle}"
                        Background="Lavender">
                    <Image Source="pack://application:,,,/Resources/gear.png" 
                           Width="20" Height="20" 
                           Stretch="UniformToFill"/>
                </Button>
                <!-- Help Button -->
                <Button Width="40" Height="40" 
                        ToolTip="How to drag and drop files into the application." 
                        Click="ShowDragDropInstructions"
                        Style="{StaticResource CircularButtonStyle}"
                        Background="Lavender">
                    <Image Source="pack://application:,,,/Resources/help.png" 
                           Width="20" Height="20" 
                           Stretch="UniformToFill"/>
                </Button>

                <!-- Company Logo -->
                <Image x:Name="AppLogo"
                       Source="pack://application:,,,/Resources/logo.png"
                       Height="60"
                       Margin="0,0,20,0"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Input Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Input Folder -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                Style="{StaticResource RoundedButtonStyle}" 
                Command="{Binding BrowseFolderCommand}" 
                Height="36" Margin="0,0,14,0">
                    <TextBlock Text="Browse Input Folder" VerticalAlignment="Center"/>
                </Button>

                <TextBox Grid.Column="1"
                 Height="36"
                 VerticalContentAlignment="Center"
                 Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FilePathTextBoxStyle}"
                 ToolTip="You can also paste or type the folder path here"/>
            </Grid>

            <!-- Input Files -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                Style="{StaticResource RoundedButtonStyle}" 
                Command="{Binding BrowseFilesCommand}" 
                Height="36" Margin="0,0,14,0">
                    <TextBlock Text="Browse Input Files" VerticalAlignment="Center"/>
                </Button>

                <TextBox Grid.Column="1"
                 Height="36"
                 VerticalContentAlignment="Center"
                 Text="{Binding FilesCountText, Mode=OneWay}" 
                 IsReadOnly="True"
                 Style="{StaticResource FilePathTextBoxStyle}"/>
            </Grid>

            <!-- Output Folder -->
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148.75"/>
                    <ColumnDefinition Width="51.25"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource RoundedButtonStyle}" 
                Command="{Binding BrowseOutputFolderCommand}"
                Height="36" Margin="0,0,14,0">
                    <TextBlock Text="Browse Output Folder" VerticalAlignment="Center"/>
                </Button>

                <TextBox Grid.Column="2"
                 Height="36"
                 VerticalContentAlignment="Center"
                 Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FilePathTextBoxStyle}"
                 ToolTip="You can also paste or type the output folder path here"/>
                
            </Grid>
            
        </Grid>

        <!-- Filters with dynamic theming -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Date Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Created Date From -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="📅 Created Date From" FontWeight="SemiBold" Margin="0,0,0,5"
                               Foreground="{DynamicResource ForegroundColor}"
                               Style="{StaticResource LabelTextBlockStyle}"/>
                    <Border BorderBrush="{DynamicResource TextBoxBorderBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="2" Background="{DynamicResource DatePickerBackground}"
                            Style="{StaticResource InputBorderStyle}">
                        <DatePicker SelectedDate="{Binding CreatedDateStart}" 
                                   Background="Transparent" BorderThickness="0"
                                   Foreground="{DynamicResource DatePickerForeground}"
                                   Text="Select a date"/>
                    </Border>
                </StackPanel>

                <!-- Created Date To -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="📅 To" FontWeight="SemiBold" Margin="0,0,0,5"
                               Foreground="{DynamicResource ForegroundColor}"
                               Style="{StaticResource LabelTextBlockStyle}"/>
                    <Border BorderBrush="{DynamicResource TextBoxBorderBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="2" Background="{DynamicResource DatePickerBackground}"
                            Style="{StaticResource InputBorderStyle}">
                        <DatePicker SelectedDate="{Binding CreatedDateEnd}" 
                                   Background="Transparent" BorderThickness="0"
                                   Foreground="{DynamicResource DatePickerForeground}"
                                   Text="Select a date"/>
                    </Border>
                </StackPanel>

                <!-- Modified Date From -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="📅 Modified Date From" FontWeight="SemiBold" Margin="0,0,0,5"
                               Foreground="{DynamicResource ForegroundColor}"
                               Style="{StaticResource LabelTextBlockStyle}"/>
                    <Border BorderBrush="{DynamicResource TextBoxBorderBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="2" Background="{DynamicResource DatePickerBackground}"
                            Style="{StaticResource InputBorderStyle}">
                        <DatePicker SelectedDate="{Binding ModifiedDateStart}" 
                                   Background="Transparent" BorderThickness="0"
                                   Foreground="{DynamicResource DatePickerForeground}"
                                   Text="Select a date"/>
                    </Border>
                </StackPanel>

                <!-- Modified Date To -->
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="📅 To" FontWeight="SemiBold" Margin="0,0,0,5"
                               Foreground="{DynamicResource ForegroundColor}"
                               Style="{StaticResource LabelTextBlockStyle}"/>
                    <Border BorderBrush="{DynamicResource TextBoxBorderBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="2" Background="{DynamicResource DatePickerBackground}"
                            Style="{StaticResource InputBorderStyle}">
                        <DatePicker SelectedDate="{Binding ModifiedDateEnd}" 
                                   Background="Transparent" BorderThickness="0"
                                   Foreground="{DynamicResource DatePickerForeground}"
                                   Text="Select a date"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Search and Clear -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="🔍 Search File Name" FontWeight="SemiBold" Margin="0,0,0,5"
                               Foreground="{DynamicResource ForegroundColor}"
                               Style="{StaticResource LabelTextBlockStyle}"/>
                    <Border BorderBrush="{DynamicResource TextBoxBorderBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="2" Background="{DynamicResource TextBoxBackground}"
                            Style="{StaticResource InputBorderStyle}">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBoxForeground}"
                                 Padding="8" FontSize="14"/>
                    </Border>
                </StackPanel>

                <!-- Clear Button -->
                <Button Grid.Column="1" 
                        Content="Clear Filter" 
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource RoundedButtonStyle}" 
                        Background="#DC3545" 
                        VerticalAlignment="Bottom"
                        Margin="0,25,0,0"/>
            </Grid>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="2" 
                CornerRadius="8" Margin="0,0,0,15" Background="{DynamicResource DataGridBackground}"
                Style="{StaticResource DataGridBorderStyle}">
            <DataGrid ItemsSource="{Binding PagedFiles}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      IsReadOnly="False" 
                      SelectionChanged="DataGrid_SelectionChanged"
                      GridLinesVisibility="None"
                      AlternatingRowBackground="{DynamicResource DataGridAlternatingBackground}"
                      Background="{DynamicResource DataGridBackground}"
                      Foreground="{DynamicResource ForegroundColor}">

                <DataGrid.Resources>
                    <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForeground}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="40"/>
                    </Style>

                    <Style x:Key="CenterTextCellStyle" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                    </Style>

                    <Style x:Key="CenterCheckBoxCellStyle" TargetType="CheckBox">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Header="Select" Width="60"
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterCheckBoxCellStyle}" />

                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" 
                                        HeaderStyle="{StaticResource CenterHeaderStyle}"
                                        ElementStyle="{StaticResource CenterTextCellStyle}" />

                    <DataGridTextColumn Header="Rename PDF(Double Click)" Binding="{Binding CustomPdfName, Mode=TwoWay}" Width="1.5*" 
                                        HeaderStyle="{StaticResource CenterHeaderStyle}"
                                        ElementStyle="{StaticResource CenterTextCellStyle}" />

                    <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate}" Width="1.2*" 
                                        HeaderStyle="{StaticResource CenterHeaderStyle}"
                                        ElementStyle="{StaticResource CenterTextCellStyle}" />

                    <DataGridTextColumn Header="Modified Date" Binding="{Binding ModifiedDate}" Width="1.2*" 
                                        HeaderStyle="{StaticResource CenterHeaderStyle}"
                                        ElementStyle="{StaticResource CenterTextCellStyle}" />

                    <DataGridTextColumn Header="Size" Binding="{Binding FileSize}" Width="80"
                                        HeaderStyle="{StaticResource CenterHeaderStyle}"
                                        ElementStyle="{StaticResource CenterTextCellStyle}" />

                    <DataGridTemplateColumn Header="Status" Width="1*" HeaderStyle="{StaticResource CenterHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error: pfcExceptions::XToolkitGeneralError">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error: File exists, not overwritten.">
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination and Action Buttons -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Size -->
            <StackPanel Grid.Column="0"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="0,0,10,0"
            Background="Transparent"
            Height="34">

                <TextBlock Text="Items per page:"
               VerticalAlignment="Center"
               Margin="0,0,8,0"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="{DynamicResource ForegroundColor}"
               Style="{StaticResource LabelTextBlockStyle}"/>

                <ComboBox Width="60"
              Height="28"
              FontSize="13"
              Padding="4,0"
              Background="{DynamicResource ComboBoxBackground}"
              BorderBrush="{DynamicResource ComboBoxBorderBrush}"
              BorderThickness="1"
              VerticalContentAlignment="Center"
              SelectedValue="{Binding PageSize, Mode=TwoWay}"
              SelectedValuePath="Content"
              Style="{StaticResource MinimalComboBoxStyle}">

                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="50"/>
                </ComboBox>
            </StackPanel>

            <!-- Navigation Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <ToggleButton x:Name="ToggleThemeButton"
              Content="🌙"
              Width="60" Height="28"    
                    FontSize="14"
              Padding="0"
              Checked="ToggleTheme_Checked"
              Unchecked="ToggleTheme_Unchecked"
              Style="{StaticResource ToggleButtonStyle}"
              ToolTip="Toggle Theme"/>
                    <Button Content="✓"
                Command="{Binding ToggleSelectCommand}"
                ToolTip="{Binding SelectDeselectButtonText}"
                Style="{StaticResource CircularButtonStyle}"
                Width="30" Height="30"
                Margin="2,0"
                Background="#2E3A59"/>

                
                <Button Command="{Binding InvertSelectionCommand}"
                Style="{StaticResource CircularButtonStyle}"
                ToolTip="Invert Selection"
                Width="30" Height="30"
                         Background="#2E3A59"
                Margin="2,0">
                    <Image Source="/Resources/repeat.png" Width="16" Height="16"/>
                </Button>

                <Button Command="{Binding PreviousPageCommand}"
                Style="{StaticResource CircularButtonStyle}"
                ToolTip="Previous Page"
                Width="30" Height="30"
                         Background="#2E3A59"
                Margin="2,0">
                    <Image Source="pack://application:,,,/Resources/arrow-left.png" Width="16" Height="16"/>
                </Button>

                <Border Background="{DynamicResource PaginationBorderBackground}" 
                        BorderBrush="{DynamicResource PaginationBorderBrush}" 
                        BorderThickness="1.5"
                        CornerRadius="10" Padding="8,4" Margin="6,0"
                        Style="{StaticResource PaginationBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding CurrentPageInput, UpdateSourceTrigger=PropertyChanged}"
                         Width="30" Height="20"
                         FontSize="12" FontWeight="Bold"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         KeyDown="PageNumberTextBox_KeyDown"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource ForegroundColor}"/>
                        <TextBlock Text=" / " VerticalAlignment="Center" FontSize="12" Margin="4,0"
                                   Foreground="{DynamicResource ForegroundColor}"/>
                        <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundColor}"/>
                    </StackPanel>
                </Border>

                <Button Command="{Binding NextPageCommand}"
                Style="{StaticResource CircularButtonStyle}"
                ToolTip="Next Page"
                Width="30" Height="30" 
                         Background="#2E3A59"
                Margin="2,0">
                    <Image Source="pack://application:,,,/Resources/arrow-right.png" Width="16" Height="16"/>
                </Button>

                <Button Content="🏠"
                Command="{Binding ResetPageCommand}"
                ToolTip="Go to Page 1"
                Style="{StaticResource CircularButtonStyle}"
                Width="40" Height="40"
                Margin="2,0"
                Background="#2E3A59"/>

            </StackPanel>

            <!-- Publish and Merge -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <CheckBox
                  IsChecked="{Binding IsMergeEnabled}"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Margin="0,0,10,0" ToolTip="Merge Into Single PDF"
                  Style="{StaticResource ToggleCheckBoxStyle}"/>

                <Button Command="{Binding PublishCommand}"
        ToolTip="Publish the files"
        Style="{StaticResource RoundedButtonStyle}"
        Background="#28A745"
        Width="100" Height="33">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Publish" 
                   FontSize="15" 
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Log -->
        <TextBox Grid.Row="5"
                 Text="{Binding Log}"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 FontWeight="Normal"
                 FontSize="14"
                 Padding="10"
                 Height="Auto"
                 Style="{StaticResource LogTextBoxStyle}" />

        <!-- Drag & Drop Overlay -->
        <TextBlock x:Name="DragDropOverlay"
                   Text="Drop files or folders here"
                   FontSize="36" FontWeight="Bold"
                   Foreground="White"
                   Background="{DynamicResource OverlayBackground}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="20"
                   TextAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="1000" />
    </Grid>
</Window>