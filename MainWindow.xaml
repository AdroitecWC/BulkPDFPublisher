<Window x:Class="CreoPublisherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CreoPublisherApp"
        Title="Creo PDF Batch Publisher" Height="720" Width="960"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="600"
       >
    <Window.Resources>
        <!-- Style for TextBoxes with black border and larger size -->
        <Style x:Key="FilePathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFDFDFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Search TextBox -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FilePathTextBoxStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FFF0F0F0"/>
        </Style>

        <!-- Style for Log TextBox (multiline) -->
        <Style x:Key="LogTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFBFBFB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Page Number TextBox -->
        <Style x:Key="PageNumberTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FilePathTextBoxStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Filter Field TextBoxes (e.g., Name, Date, Size) -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FilePathTextBoxStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FFF8F8F8"/>
            <Setter Property="Margin" Value="4,2,4,2"/>
        </Style>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="SteelBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
            <!-- smaller padding -->
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
           
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="18"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- DataGrid Styling -->
        <Style TargetType="DataGrid">
            <Setter Property="AlternatingRowBackground" Value="#F7F7F7"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Animations -->
        <Storyboard x:Key="FadeInOverlay">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="FadeOutOverlay">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="PulseOverlay" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1" Duration="0:0:1" />
        </Storyboard>
         
 
    </Window.Resources>

    <Grid Margin="15" AllowDrop="True"
          DragEnter="Grid_DragEnter"
          DragLeave="Grid_DragLeave"
          Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <!-- Company Logo Left -->
            <Image Source="pack://application:,,,/Resources/logo.png"
           Height="60"
           Margin="0,0,10,0"
           DockPanel.Dock="Left"
           Stretch="Uniform"
           VerticalAlignment="Center"/>

            <!-- Help Button -->
            <Button Width="35" ToolTip=" How to drag and drop files into the application." Height="35" Click="ShowDragDropInstructions" DockPanel.Dock="Right" Margin="0,0,8,0">
                <Image Source="pack://application:,,,/Resources/help.png" Stretch="UniformToFill"/>
            </Button>

            <!-- Settings Button -->
            <Button Width="35" Height="35" ToolTip="Open export and application settings." Command="{Binding OpenSettingsWindowCommand}" DockPanel.Dock="Right">
                <Image Source="pack://application:,,,/Resources/gear.png" Stretch="UniformToFill"/>
            </Button>
        </DockPanel>

        <!-- Input Folder -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource RoundedButtonStyle}" Command="{Binding BrowseFolderCommand}" Width="auto" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/folder-open.png" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Browse Input Folder" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Button>
            <TextBox Grid.Column="1"
                     Text="{Binding InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FilePathTextBoxStyle}"
                     HorizontalAlignment="Stretch"
                     ToolTip="You can also paste or type the folder path here"/>
        </Grid>

        <!-- Input Files -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource RoundedButtonStyle}" Command="{Binding BrowseFilesCommand}" Width="auto" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/file-add.png" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Browse Input Files   " VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Button>
            <TextBox Grid.Column="1"
                     Text="{Binding FilesCountText, Mode=OneWay}" 
                     IsReadOnly="True"
                     Style="{StaticResource FilePathTextBoxStyle}"
                     HorizontalAlignment="Stretch"/>
        </Grid>

        <!-- Output Folder -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource RoundedButtonStyle}" Command="{Binding BrowseOutputFolderCommand}" Width="auto" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/folder-open.png" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Browse Output Folder" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Button>
            <TextBox Grid.Column="1"
                     Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FilePathTextBoxStyle}"
                     HorizontalAlignment="Stretch"
                     ToolTip="You can also paste or type the output folder path here"/>
        </Grid>



        <!-- Filters -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Created Date From -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock>
            <Run FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Foreground="DarkSlateGray" FontSize="14"/>
            <Run Text=" Created Date From" />
                </TextBlock>
                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,4,0,0" Background="White">
                    <DatePicker SelectedDate="{Binding CreatedDateStart}" Background="Transparent" BorderThickness="0"/>
                </Border>
            </StackPanel>

            <!-- Created Date To -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
                <TextBlock>
            <Run FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Foreground="DarkSlateGray" FontSize="14"/>
            <Run Text=" To" />
                </TextBlock>
                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,4,0,0" Background="White">
                    <DatePicker SelectedDate="{Binding CreatedDateEnd}" Background="Transparent" BorderThickness="0"/>
                </Border>
            </StackPanel>

            <!-- Modified Date From -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,0">
                <TextBlock>
            <Run FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Foreground="DarkSlateGray" FontSize="14"/>
            <Run Text=" Modified Date From" />
                </TextBlock>
                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,4,0,0" Background="White">
                    <DatePicker SelectedDate="{Binding ModifiedDateStart}" Background="Transparent" BorderThickness="0"/>
                </Border>
            </StackPanel>

            <!-- Modified Date To -->
            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,0">
                <TextBlock>
            <Run FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Foreground="DarkSlateGray" FontSize="14"/>
            <Run Text=" To" />
                </TextBlock>
                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,4,0,0" Background="White">
                    <DatePicker SelectedDate="{Binding ModifiedDateEnd}" Background="Transparent" BorderThickness="0"/>
                </Border>
            </StackPanel>

            <!-- Search and Clear -->
            <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box with icon -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock>
                <Run FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="DarkSlateGray" FontSize="14"/>
                <Run Text=" Search File Name" />
                    </TextBlock>

                    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,4,0,0" Background="White">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4"
                         FontSize="13"/>
                    </Border>
                </StackPanel>

                <!-- Clear Button -->
                <Button Grid.Column="1" Content="Clear Filter" Command="{Binding ClearFiltersCommand}"
                Style="{StaticResource RoundedButtonStyle}" Background="IndianRed" Foreground="White"
                Margin="10,20,0,0"/>
            </Grid>
        </Grid>


        <!-- DataGrid for Selection and File Grid -->
        <Border Grid.Row="5"
        BorderBrush="Black"
        BorderThickness="1"
        CornerRadius="8"
        Margin="0,0,0,10"
        Background="White">
            <DataGrid ItemsSource="{Binding PagedFiles}" AutoGenerateColumns="False" CanUserAddRows="False"
              IsReadOnly="False" SelectionChanged="DataGrid_SelectionChanged"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              RowHeight="34"
              FontSize="13"
              GridLinesVisibility="None"
              AlternatingRowBackground="#F7F7F7"
              >
                <DataGrid.Resources>
                    <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!-- Fixed width for checkbox -->
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Header="Select" Width="60" />

                    <!-- Proportional widths for rest -->
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*" />
                    <DataGridTextColumn Header="Rename PDF(Double Click)" Binding="{Binding CustomPdfName, Mode=TwoWay}" Width="2*" />
                    <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate}" Width="1.5*" />
                    <DataGridTextColumn Header="Modified Date" Binding="{Binding ModifiedDate}" Width="1.5*" />

                    <!-- Fixed small width for Size -->
                    <DataGridTextColumn Header="Size" Binding="{Binding FileSize}" Width="90"/>

                    <!-- Wider status column -->
                    <DataGridTemplateColumn Header="Status" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="File Exists">
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- Stack which navigates previous and next -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Page Size Dropdown -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0">
                <TextBlock Text="Items per page:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold"/>
                <ComboBox Width="80" SelectedValue="{Binding PageSize, Mode=TwoWay}" SelectedValuePath="Content" FontSize="13">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="50"/>
                </ComboBox>
            </StackPanel>

            <!-- Navigation Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">

                <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource RoundedButtonStyle}" Width="120">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/arrow-left.png" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Previous" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBox Text="{Binding CurrentPageInput, UpdateSourceTrigger=PropertyChanged}" 
             Width="40" Height="24" VerticalContentAlignment="Center"
             FontWeight="Bold" FontSize="14" Margin="10,0"
             HorizontalContentAlignment="Center"
             KeyDown="PageNumberTextBox_KeyDown"  Style="{StaticResource PageNumberTextBoxStyle}"/>

                <TextBlock Text=" / " VerticalAlignment="Center" FontSize="14"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>

                <Button Command="{Binding NextPageCommand}" Style="{StaticResource RoundedButtonStyle}" Width="100">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                        <Image Source="pack://application:,,,/Resources/arrow-right.png" Width="14" Height="14" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Content="Go to Page 1" Command="{Binding ResetPageCommand}" 
            Style="{StaticResource RoundedButtonStyle}"  Margin="15,0,0,0"
            ToolTip="Reset the file list to start from Page 1"/>
            </StackPanel>

        </Grid>

        <!-- Action Buttons -->
        <Border Grid.Row="7" Margin="0,10,0,8" Padding="10"
        BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Background="#F8F8F8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
                <Button Content= "{Binding SelectDeselectButtonText}" 
            Command="{Binding ToggleSelectCommand}" 
                ToolTip="Select or deselect all files." 
            Style="{StaticResource RoundedButtonStyle}" 
                Foreground="White" />
                <Button Content="Invert Selection" Command="{Binding InvertSelectionCommand}" 
                ToolTip="Invert the files." Style="{StaticResource RoundedButtonStyle}" 
                 Foreground="White"/>

                <Button Command="{Binding PublishCommand}" ToolTip="Publish the files." 
                Style="{StaticResource RoundedButtonStyle}" Background="ForestGreen" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Resources/upload.png" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Publish"/>
                    </StackPanel>
                </Button>
                <CheckBox Content="Merge into Single PDF"
          IsChecked="{Binding IsMergeEnabled}"
          Margin="10"
          FontWeight="Bold"/>

            </StackPanel>
        </Border>

        <!-- Log -->
        <TextBox Grid.Row="8"
         Text="{Binding Log}"
         IsReadOnly="True"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         TextWrapping="Wrap"
         FontFamily="Consolas"
         FontWeight="Normal"
         FontSize="14"
         Padding="10"
         Height="Auto"
         Style="{StaticResource LogTextBoxStyle}" />

        <!-- Drag & Drop Overlay -->
        <TextBlock x:Name="DragDropOverlay"
                   Text="Drop files or folders here"
                   FontSize="36" FontWeight="Bold"
                   Foreground="White"
                   Background="#AA000000"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="20"
                   TextAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="1000" />
    </Grid>
</Window>
