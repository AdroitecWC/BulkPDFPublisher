<Window x:Class="CreoPublisherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CreoPublisherApp"       
        Title="Bulk PDF Publisher" Height="750" Width="1000"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource ForegroundColor}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      
        
        <!-- Light Theme Resources (Default) -->
        <BitmapImage x:Key="LightLogoSource" UriSource="pack://application:,,,/Resources/logo.png"/>
        <BitmapImage x:Key="LogoSource" UriSource="pack://application:,,,/Resources/logo.png"/>
        <BitmapImage x:Key="DarkLogoSource" UriSource="pack://application:,,,/Resources/logo-white.png"/>
        <BitmapImage x:Key="RefreshFilter" UriSource="pack://application:,,,/Resources/Refresh.png"/>
        <BitmapImage x:Key="LightRefreshFilter" UriSource="pack://application:,,,/Resources/Refresh.png"/>
        <BitmapImage x:Key="DarkRefreshFilter" UriSource="pack://application:,,,/Resources/Refresh-white.png"/>
        <BitmapImage x:Key="LightRepeatFilter" UriSource="pack://application:,,,/Resources/repeat.png"/>
        <BitmapImage x:Key="DarkRepeatFilter" UriSource="pack://application:,,,/Resources/repeat-white.png"/>
        <BitmapImage x:Key="RepeatFilter" UriSource="pack://application:,,,/Resources/repeat.png"/>
        <BitmapImage x:Key="TickFilter" UriSource="/Resources/tick.png"/>
        <BitmapImage x:Key="LightTickFilter" UriSource="/Resources/tick.png"/>
        <BitmapImage x:Key="DarkTickFilter" UriSource="/Resources/tick-white.png"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="ForegroundColor" Color="#2E3A59"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#2E3A59"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#0056B3"/>
        <SolidColorBrush x:Key="ButtonPressedBackground" Color="#004085"/>
        <SolidColorBrush x:Key="TextBoxBackground" Color="White"/>
        <SolidColorBrush x:Key="TextBoxForeground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="SearchTextBoxBackground" Color="White"/>
        <SolidColorBrush x:Key="LogTextBoxBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="LogTextBoxBorderBrush" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="FilterTextBoxBackground" Color="White"/>
        <SolidColorBrush x:Key="DataGridBackground" Color="White"/>
        <SolidColorBrush x:Key="DataGridAlternatingBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#2E3A59"/>
        <SolidColorBrush x:Key="DataGridHeaderForeground" Color="White"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DatePickerBackground" Color="White"/>
        <SolidColorBrush x:Key="DatePickerForeground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TitleForeground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PaginationBorderBackground" Color="White"/>
        <SolidColorBrush x:Key="PaginationBorderBrush" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="OverlayBackground" Color="#AA000000"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="White"/>
        <SolidColorBrush x:Key="SectionBackground" Color="White"/>
        <SolidColorBrush x:Key="StepIconBackground" Color="#E9ECEF"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ForegroundColorSecondary" Color="#6C757D" />
        <SolidColorBrush x:Key="ForegroundColorError" Color="#DC3545" />


        <!-- Dark Theme Resources -->
        <SolidColorBrush x:Key="DarkBackgroundColor" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="DarkForegroundColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DarkButtonBackground" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="DarkButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="DarkButtonHoverBackground" Color="#0B5ED7"/>
        <SolidColorBrush x:Key="DarkButtonPressedBackground" Color="#0A58CA"/>
        <SolidColorBrush x:Key="DarkTextBoxBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkTextBoxForeground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DarkTextBoxBorderBrush" Color="#404040"/>
        <SolidColorBrush x:Key="DarkSearchTextBoxBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkLogTextBoxBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkLogTextBoxBorderBrush" Color="#404040"/>
        <SolidColorBrush x:Key="DarkFilterTextBoxBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkDataGridBackground" Color="#404040"/>
        <SolidColorBrush x:Key="DarkDataGridAlternatingBackground" Color="#404040"/>
        <SolidColorBrush x:Key="DarkDataGridHeaderBackground" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="DarkDataGridHeaderForeground" Color="White"/>
        <SolidColorBrush x:Key="DarkBorderBrushColor" Color="#404040"/>
        <SolidColorBrush x:Key="DarkComboBoxBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkComboBoxBorderBrush" Color="#404040"/>
        <SolidColorBrush x:Key="DarkComboBoxForeground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DarkDatePickerBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkDatePickerForeground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DarkTitleForeground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DarkPaginationBorderBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkPaginationBorderBrush" Color="#404040"/>
        <SolidColorBrush x:Key="DarkOverlayBackground" Color="#AA1A1A1A"/>
        <SolidColorBrush x:Key="DarkSidebarBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkSectionBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="DarkStepIconBackground" Color="#404040"/>
        <SolidColorBrush x:Key="DarkExpanderHeaderBackground" Color="#2D2D2D"/>
        <!-- DarkTheme.xaml -->
        <SolidColorBrush x:Key="DarkForegroundColorSecondary" Color="#CCCCCC" />
        <SolidColorBrush x:Key="DarkForegroundColorError" Color="#FF6B6B" />



        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2E3A59"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>


        <!-- Success Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="0" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker Style -->
        <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource DatePickerBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DatePickerForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Expander Style -->
        <Style x:Key="ModernExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource ExpanderHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- DataGrid Styling -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource DataGridBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAlternatingBackground}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Section Card Style -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SectionBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Step Icon Background Style -->
        <Style x:Key="StepIconBackgroundStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SectionBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#CED4DA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBackground"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="12"/>
                            <Ellipse x:Name="SwitchThumb"
                                   Width="18" Height="18"
                                   Fill="White"
                                   Margin="3"
                                   HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBackground" Property="Background" Value="#007BFF"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#CED4DA"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            BorderBrush="Transparent"
                            BorderThickness="1"/>
                            <Ellipse x:Name="SwitchKnob"
                             Width="18" Height="18"
                             Fill="White"
                             Margin="3"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0"
                                      RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Animations -->
        <Storyboard x:Key="FadeInOverlay">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3" />
        </Storyboard>

        <Storyboard x:Key="FadeOutOverlay">
            <DoubleAnimation Storyboard.TargetName="DragDropOverlay"
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.3" />
        </Storyboard>
    </Window.Resources>

    <Grid AllowDrop="True"
          DragEnter="Grid_DragEnter"
          DragLeave="Grid_DragLeave"
          Drop="Grid_Drop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" 
        Background="{DynamicResource SidebarBackground}"
        BorderBrush="{DynamicResource BorderBrushColor}"
        BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Bulk PDF Publisher" 
                           FontSize="20" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundColor}"/>
                    </Grid>

                    <!-- Step 1: Select Input Folder -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,8,0" Width="24" Height="24">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                                                        <Setter Property="Fill" Value="#28A745"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="1"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="LightGray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" 
                                   Text="Select Input Folder" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Folder icon area made clickable -->
                            <Border  x:Name="InputFolderBorder"
                            Style="{StaticResource StepIconBackgroundStyle}"
                            AllowDrop="True"
                            MouseLeftButtonUp="FolderIcon_Click" 
                             DragOver="InputFolderIcon_DragOver"       
                           Drop="InputFolderIcon_Drop">
                                <StackPanel>
                                    <Image Source="/Resources/folder-open.png" 
                                   Width="32" Height="32" 
                                   Margin="0,0,0,8"/>
                                    <TextBlock Text="Drag &amp; drop folder here" 
                                       HorizontalAlignment="Center" 
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       Margin="0,0,0,4"/>
                                    <TextBlock Text="or click to browse" 
                                       HorizontalAlignment="Center" 
                                       FontSize="12" 
                                        Foreground="{DynamicResource ForegroundColor}"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <!-- Path TextBlock -->
                                <TextBlock Text="{Binding InputPath}" 
               FontSize="12" 
               FontWeight="Bold"
               Foreground="{DynamicResource ForegroundColor}" 
               TextTrimming="CharacterEllipsis"
               ToolTip="{Binding InputPath}" 
               VerticalAlignment="Center"
               Padding="0,0,20,0"/>
                                <!-- leave space for tick -->

                                <!-- Tick mark -->
                                <Image Source="{DynamicResource TickFilter}" 
       Width="16" Height="16" 
       VerticalAlignment="Center" 
       HorizontalAlignment="Right"
       Margin="0,0,2,0"
       Visibility="{Binding HasInputFolder, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding NoInputFolderText}" 
                            FontSize="12" 
                        Foreground="#DC3545"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Output Destination -->
                    <Border Style="{StaticResource SectionCardStyle}"
                             IsEnabled="{Binding CanSelectOutputFolder}" >
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,8,0" Width="24" Height="24">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                                                        <Setter Property="Fill" Value="#28A745"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="2"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="LightGray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" 
                                   Text="Select Output Folder" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Folder icon area made clickable -->
                            <Border
                             Style="{StaticResource StepIconBackgroundStyle}"
                            AllowDrop="True"
                            MouseLeftButtonUp="OutputFolderIcon_Click" 
                            DragOver="OutputFolderIcon_DragOver" 
                            Drop="OutputFolderIcon_Drop">
                                <StackPanel>
                                    <Image Source="/Resources/folder-open.png" 
                                   Width="32" Height="32" 
                                   Margin="0,0,0,8"/>
                                    <TextBlock Text="Drag &amp; drop output folder" 
                                       HorizontalAlignment="Center" 
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       Margin="0,0,0,4"/>
                                    <TextBlock Text="or click to browse" 
                                       HorizontalAlignment="Center" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ForegroundColor}"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <!-- Path TextBlock -->
                                <TextBlock Text="{Binding OutputPath}" 
               FontSize="12" 
               FontWeight="Bold"
               Foreground="{DynamicResource ForegroundColor}" 
               TextTrimming="CharacterEllipsis"
               ToolTip="{Binding OutputPath}" 
               VerticalAlignment="Center"
               Padding="0,0,20,0"/>
                                <!-- leave space for tick -->

                                <!-- Tick mark -->
                                <Image Source="{DynamicResource TickFilter}" 
       Width="16" Height="16" 
       VerticalAlignment="Center" 
       HorizontalAlignment="Right"
       Margin="0,0,2,0"
       Visibility="{Binding HasOutputFolder, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding NoOutputFolderText}" 
                               FontSize="12" 
                               Foreground="#DC3545"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Review & Publish -->
                    <Border Style="{StaticResource SectionCardStyle}"
                            IsEnabled="{Binding CanReviewPublish}">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,8,0" Width="24" Height="24">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep3Completed}" Value="True">
                                                        <Setter Property="Fill" Value="#28A745"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="3"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="LightGray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep3Completed}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" 
                       Text="Review &amp; Publish" 
                       FontWeight="SemiBold" 
                       FontSize="16"
                       Foreground="{DynamicResource ForegroundColor}"
                       VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanReviewPublish}" Value="False">
                                                    <Setter Property="ToolTip" Value="Please complete Step 2 first."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Files:" FontSize="12" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding TotalFilesCount}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ForegroundColor}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Selected:" FontSize="12" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding SelectedFilesCount}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ForegroundColor}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Files Renamed:" FontSize="12" Foreground="#6C757D"/>
                                    <TextBlock Text="{Binding FilesToRenameCount}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ForegroundColor}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0"
                                      IsChecked="{Binding IsMergeEnabled}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="1" 
                                   Text="Merge into single PDF" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   FontSize="14"/>
                            </Grid>

                            <Button Command="{Binding PublishCommand}"
        HorizontalAlignment="Stretch"
        FontSize="16"
        Padding="16,12"
        Style="{StaticResource SuccessButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Spinner: Visible only when IsPublishing is true -->

                                    <!-- Button text -->
                                    <TextBlock Text="{Binding PublishButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- Publishing Logs -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Circle with number -->
                                <Grid Grid.Column="0" Margin="0,0,8,0" Width="25" Height="25">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep4Completed}" Value="True">
                                                        <Setter Property="Fill" Value="#28A745"/>
                                                        <!-- Green -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Text="4"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="LightGray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep3Completed}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" 
                       Text="Publishing Logs" 
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundColor}"
                       VerticalAlignment="Center"/>
                            </Grid>

                            <TextBox Text="{Binding Log}"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="11"
                 Height="100"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 Background="{DynamicResource LogTextBoxBackground}"
                 Foreground="{DynamicResource ForegroundColor}"
                 BorderBrush="{DynamicResource LogTextBoxBorderBrush}"
                 BorderThickness="1"
                 Padding="8"/>
                            <Button Content="📊 Open Report"
        Command="{Binding OpenReportCommand}"
        Margin="0,12,0,0"
        HorizontalAlignment="Stretch"
        FontSize="14"
        Padding="12,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReportFilePath}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ReportFilePath}" Value="">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Logo and Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="0,0,15,0">
                    <Image Width="120" Height="60"
           Source="{DynamicResource LogoSource}" />
                </StackPanel>
                <!-- Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" >

                    <!-- Theme toggle -->
                    <ToggleButton x:Name="ToggleThemeButton"
              Content="🌙"
              Width="60" Height="28"    
                    FontSize="14"
              Padding="0"
              Checked="ToggleTheme_Checked"
              Unchecked="ToggleTheme_Unchecked"
              Style="{StaticResource ToggleButtonStyle}"
              ToolTip="Toggle Theme"/>
                    <!-- Settings Button -->
                    <Button Width="40" Height="40"
            ToolTip="Open export and application settings"
            Command="{Binding OpenSettingsWindowCommand}"
            Style="{StaticResource IconButtonStyle}"
            Padding="8"
            Margin="0,0,6,0"
            Click="Button_Click_1">
                        <Image Source="pack://application:,,,/Resources/gear.png" Width="28" Height="24">
                            <Image.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.7"/>
                            </Image.Effect>
                        </Image>

                    </Button>

                    <!-- Help Button -->
                    <Button Width="40" Height="40"
            ToolTip="How to drag and drop files"
            Click="ShowDragDropInstructions"
            Style="{StaticResource IconButtonStyle}"
            Padding="8">
                        <Image Source="pack://application:,,,/Resources/help.png" Width="28" Height="24">
                            <Image.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.7"/>
                            </Image.Effect>
                        </Image>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search Section and Selection Controls -->
            <Border Grid.Row="2"
        Style="{StaticResource SectionCardStyle}"
        Margin="0,0,0,20">

                <!-- Right-aligned button group -->
                <StackPanel Margin="20"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                    <!-- Invert Button -->
                    <Button Command="{Binding InvertSelectionCommand}"
                Padding="12,4"
                Margin="0,0,8,0"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1"
                Background="Transparent"
                Foreground="{DynamicResource ForegroundColor}"
                FontWeight="Bold"
                Cursor="Arrow"
                ToolTip="Invert Selection">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{DynamicResource RepeatFilter}"
       Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Invert" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Select All Button -->
                    <Button Content="{Binding SelectDeselectButtonText}"
                Command="{Binding ToggleSelectCommand}"
                Padding="12,4"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1"
                Background="Transparent"
                Foreground="{DynamicResource ForegroundColor}"
                FontWeight="Bold"
                Cursor="Arrow"
                ToolTip="Select / Deselect All"/>
                </StackPanel>
            </Border>

            <!-- Filters Section with Expander -->
            <Border Grid.Row="1" 
        Style="{StaticResource SectionCardStyle}"
        Margin="0,0,0,20">
                <Expander Header="🎛️ Filters" 
              IsExpanded="False"
              Style="{StaticResource ModernExpanderStyle}"
              Margin="20">
                    <StackPanel Margin="0,16,0,0">

                        <!-- Search Files -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Search Files" 
                           FontSize="12" 
                           Margin="0,0,0,4" 
                           Foreground="{DynamicResource ForegroundColor}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Date Filters -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Created From" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource ForegroundColor}"/>
                                <DatePicker SelectedDate="{Binding CreatedDateStart}"
                                Style="{StaticResource ModernDatePickerStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="To" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource ForegroundColor}"/>
                                <DatePicker SelectedDate="{Binding CreatedDateEnd}"
                                Style="{StaticResource ModernDatePickerStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Modified From" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource ForegroundColor}"/>
                                <DatePicker SelectedDate="{Binding ModifiedDateStart}"
                                Style="{StaticResource ModernDatePickerStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="To" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource ForegroundColor}"/>
                                <DatePicker SelectedDate="{Binding ModifiedDateEnd}"
                                Style="{StaticResource ModernDatePickerStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <Button Command="{Binding ClearFiltersCommand}"
                                 Width="32" Height="32"
                                 Background="Transparent"
                                  BorderBrush="Transparent"
                                  Padding="0">
                                    <Image Source="{DynamicResource RefreshFilter}" 
                                           ToolTip="Clear Filters"
                                    Width="28" Height="24" 
                                     Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                       
                    </StackPanel>
                </Expander>
            </Border>
            <!-- DataGrid -->
            <Border Grid.Row="4" 
                    Style="{StaticResource SectionCardStyle}"
                    Margin="0">
                <DataGrid ItemsSource="{Binding FilteredFiles}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="False" 
                          SelectionChanged="DataGrid_SelectionChanged"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          AlternatingRowBackground="{DynamicResource DataGridAlternatingBackground}"
                          Background="{DynamicResource DataGridBackground}"
                          Foreground="{DynamicResource ForegroundColor}"
                          Margin="16">

                    <DataGrid.Resources>
                        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForeground}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="Padding" Value="16,8"/>
                        </Style>

                        <Style x:Key="CenterTextCellStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="16,8"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                        </Style>

                        <Style x:Key="CenterCheckBoxCellStyle" TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="16,8"/>
                        </Style>

                        <!-- DataGrid Row Style -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource DataGridBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DataGridAlternatingBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <!-- DataGrid Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Header="" Width="60"
                                                HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                ElementStyle="{StaticResource CenterCheckBoxCellStyle}" />

                        <DataGridTextColumn Header="📄 File Name" Binding="{Binding FileName}" Width="2*" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}" />

                        <DataGridTextColumn Header="📝 PDF Output Name" Binding="{Binding CustomPdfName, Mode=TwoWay}" Width="2*" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}" />

                        <DataGridTextColumn Header="📅 Created" Binding="{Binding CreatedDate}" Width="1.2*" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}" />

                        <DataGridTextColumn Header="📅 Modified" Binding="{Binding ModifiedDate}" Width="1.2*" 
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}" />

                        <DataGridTextColumn Header="💾 Size" Binding="{Binding FileSize}" Width="80"
                                            HeaderStyle="{StaticResource CenterHeaderStyle}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}" />

                        <DataGridTemplateColumn Header="🔄 Status" Width="1.2*" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" 
                                            Padding="8,4" 
                                            Margin="20,8"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Success">
                                                        <Setter Property="Background" Value="Green"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error: pfcExceptions::XToolkitGeneralError">
                                                        <Setter Property="Background" Value="#E7F224"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error: File exists, not overwritten.">
                                                        <Setter Property="Background" Value="#0D20BD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Status}" 
                                                   FontWeight="Bold"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#171710"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                                            <Setter Property="Foreground" Value="white"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error: pfcExceptions::XToolkitGeneralError">
                                                            <Setter Property="Foreground" Value="white"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error: File exists, not overwritten.">
                                                            <Setter Property="Foreground" Value="white"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Drag & Drop Overlay -->
        <TextBlock x:Name="DragDropOverlay"
                   Text="Drop files or folders here"
                   FontSize="36" FontWeight="Bold"
                   Foreground="White"
                   Background="{DynamicResource OverlayBackground}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="40,20"
                   TextAlignment="Center"
                   Visibility="Collapsed"
                   Opacity="0"
                   Panel.ZIndex="1000"
                   Grid.ColumnSpan="2">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>