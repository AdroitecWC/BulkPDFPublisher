<Window x:Class="CreoPublisherApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings"
        Height="600"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f5f5"
        FontFamily="Segoe UI"
        FontSize="14"
        Loaded="SettingsWindow_Loaded">

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="15">

        <!-- ===================================================== -->
        <!-- GENERAL SETTINGS TAB -->
        <!-- ===================================================== -->
        <TabItem Header="General">

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="Configure Creo Executable Path"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2c3e50"
                           Margin="0,0,0,20"/>

                <!-- Creo Path Label -->
                <TextBlock Grid.Row="1"
                           Text="Full path to parametric.exe:"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#333"/>

                <!-- Creo Path -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding CreoPath, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6"
                             Grid.Column="0"
                             Margin="0,0,10,0"/>

                    <Button Content="Browse..."
                            Width="100"
                            Grid.Column="1"
                            Command="{Binding BrowseCommand}"
                            Background="#3498db"
                            Foreground="White"
                            Cursor="Hand"/>
                </Grid>

                <!-- Working Directory -->
                <TextBlock Grid.Row="3"
                           Text="Working directory for publishing:"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="4" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6"
                             Grid.Column="0"
                             Margin="0,0,10,0"/>

                    <Button Content="Browse..."
                            Width="100"
                            Grid.Column="1"
                            Command="{Binding BrowseWorkingDirectoryCommand}"
                            Background="#3498db"
                            Foreground="White"
                            Cursor="Hand"/>
                </Grid>

                <!-- Watermark -->
                <TextBlock Grid.Row="5"
                           Text="Watermark Settings"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,10,0,10"/>

                <CheckBox Grid.Row="6"
                          Content="Enable Watermark"
                          IsChecked="{Binding EnableWatermark}"
                          Margin="0,0,0,10"/>

                <StackPanel Grid.Row="7">

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Watermark Text:" Width="150"/>
                        <TextBox Text="{Binding WatermarkText}" Width="300"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Font Size:" Width="150"/>
                        <TextBox Text="{Binding WatermarkFontSize}" Width="80"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Opacity (0-1):" Width="150"/>
                        <Slider Minimum="0"
                                Maximum="1"
                                Value="{Binding WatermarkOpacity}"
                                Width="150"/>
                        <TextBlock Text="{Binding WatermarkOpacity, StringFormat=N2}"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Position:" Width="150"/>
                        <ComboBox Width="200"
                                  ItemsSource="{Binding WatermarkPositions}"
                                  SelectedItem="{Binding WatermarkPosition}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Save"
                            Width="80"
                            Margin="0,0,10,0"
                            Command="{Binding SaveCommand}"
                            Background="#27ae60"
                            Foreground="White"/>

                    <Button Content="Cancel"
                            Width="80"
                            Margin="0,0,10,0"
                            Command="{Binding CancelCommand}"
                            Background="#95a5a6"
                            Foreground="White"/>

                    <Button Content="OK"
                            Width="80"
                            Command="{Binding ConfirmCommand}"
                            Background="#2980b9"
                            Foreground="White"/>
                </StackPanel>

            </Grid>
        </TabItem>

        <!-- ===================================================== -->
        <!-- LICENSE TAB -->
        <!-- ===================================================== -->
        <TabItem Header="License">

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Text="License Information"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

                <!-- License Info -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="{Binding LicenseStatus}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LicenseSystemName}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding LicenseExpiry}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Vertical">

                    <Button Content="Deactivate License"
                    Width="200"
                    Height="32"
                    Margin="0,0,0,10"
                    Background="#c0392b"
                    Foreground="White"
                    Command="{Binding DeactivateLicenseCommand}"
                    Cursor="Hand"/>

                    <Button Content="Transfer License"
                    Width="200"
                    Height="32"
                    Background="#2980b9"
                    Foreground="White"
                    Command="{Binding TransferLicenseCommand}"
                    Cursor="Hand"/>

                </StackPanel>

                <!-- Warning -->
                <TextBlock Grid.Row="3"
                   Text="⚠ Transfer will deactivate license on this system"
                   Foreground="DarkRed"
                   Margin="0,10,0,0"
                   FontSize="11"/>

            </Grid>

        </TabItem>

    </TabControl>

</Window>
