<Window x:Class="CreoPublisherApp.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License"
        Height="450"
        Width="650"
        Background="{DynamicResource BackgroundColor}">

    <Window.Resources>
        <!-- Theme -->
        <SolidColorBrush x:Key="BackgroundColor" Color="White"/>
        <SolidColorBrush x:Key="ForegroundColor" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#2E3A59"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="White"/>

        <!-- Rounded Button -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                Padding="11,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2E3A59"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="License Management"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource ForegroundColor}"
                   Margin="0,0,0,15"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1">

            <!-- ===================== -->
            <!-- ACTIVATION TAB -->
            <!-- ===================== -->
            <TabItem Header="Activation">

                <StackPanel Margin="10">

                    <!-- Browse -->
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Browse License File"
                                Width="160"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="btnBrowse_Click"/>

                        <Border CornerRadius="8"
                                Background="White"
                                BorderBrush="#2E3A59"
                                BorderThickness="1"
                                Margin="10,0,0,0"
                                Height="32">
                            <TextBox x:Name="txtFilePath"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"/>
                        </Border>
                    </DockPanel>

                    <!-- System Name -->
                    <TextBlock Text="System Name" FontWeight="SemiBold"/>
                    <Border CornerRadius="8"
                            BorderBrush="#2E3A59"
                            BorderThickness="1"
                            Height="32"
                            Margin="0,0,0,10">
                        <TextBox x:Name="txtSystemName"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,0"/>
                    </Border>

                    <!-- Request Code -->
                    <TextBlock Text="Request Code" FontWeight="SemiBold"/>
                    <Border CornerRadius="8"
                            BorderBrush="#2E3A59"
                            BorderThickness="1"
                            Height="60"
                            Margin="0,0,0,15">
                        <TextBox x:Name="txtRequestCode"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,0"/>
                    </Border>

                    <!-- Expiry -->
                    <TextBlock x:Name="lblExpiry"
                               FontWeight="Bold"
                               Foreground="Green"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Activate"
                                Width="120"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="btnActivate_Click"/>

                        <Button Content="Deactivate"
                                Width="120"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#A94442"
                                Click="btnDeactivate_Click"/>
                    </StackPanel>

                </StackPanel>
            </TabItem>

            <!-- ===================== -->
            <!-- LICENSE DETAILS TAB -->
            <!-- ===================== -->
            <TabItem Header="License Details">

                <StackPanel Margin="20">

                    <TextBlock Text="License Information"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="License Status:" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtLicStatus" />
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Expiry Date:" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtLicExpiry"/>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Bound System Code:" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtLicSystemCode"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
