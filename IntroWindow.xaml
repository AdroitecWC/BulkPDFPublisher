<Window x:Class="CreoPublisherApp.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adroitec Engineering Solutions" Height="auto" Width="auto"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded"
        Background="#FF2D2D30">
    <Grid Width="auto">
        <Image Source="pack://application:,,,/Resources/background.jpeg"
       Stretch="Fill"
       Opacity="0.5"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Bulk PDF Publisher Tool"
                       FontSize="28" Foreground="White" Margin="0,0,0,20"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Batch convert drawings to PDFs with ease!"
                       FontSize="16" Foreground="LightGray" Margin="0,0,0,30"
                       HorizontalAlignment="Center"/>
            
        </StackPanel>
        <TextBlock Text="Loading, please wait..."
    FontSize="16"
    Foreground="LightGray"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Margin="0,0,0,5"/>
        <ProgressBar Name="LoadingBar"
                     Height="8"
                     VerticalAlignment="Bottom"
                     Margin="20"
                     IsIndeterminate="True"      
                     Foreground="DodgerBlue"
                     Background="Transparent"/>
       
    </Grid>
</Window>
