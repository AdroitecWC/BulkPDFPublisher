<Window x:Class="CreoPublisherApp.LicenseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Management"
        Height="480" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f5f5"
        FontFamily="Segoe UI"
        FontSize="14">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- License Management Header -->
        <TextBlock Grid.Row="0"
                   Text="License Management"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#2c3e50"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Margin="10,0,0,15">

            <RadioButton Content="Deactivate License"
                         GroupName="LicenseAction"
                         IsChecked="{Binding IsDeactivateSelected}"
                         FontWeight="SemiBold"
                         Margin="0,5"/>

            <RadioButton Content="Transfer License"
                         GroupName="LicenseAction"
                         IsChecked="{Binding IsTransferSelected}"
                         FontWeight="SemiBold"
                         Margin="0,5"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <StackPanel.Resources>
                <!-- Rounded Button Style -->
                <Style x:Key="RoundedButtonStyle" TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="15,8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="Black"
                                                                  BlurRadius="10"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                        <Setter TargetName="border" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
            </StackPanel.Resources>

            <Button Content="{Binding PrimaryLicenseActionText}"
                    Width="160"
                    Height="36"
                    Margin="0,0,10,0"
                    Background="#c0392b"
                    Foreground="White"
                    BorderBrush="#922b21"
                    BorderThickness="1"
                    Command="{Binding PrimaryLicenseActionCommand}"
                    Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="Cancel"
                    Width="80"
                    Height="36"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"
                    Background="#95a5a6"
                    Foreground="White"
                    BorderBrush="#7f8c8d"
                    BorderThickness="1"
                    Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="OK"
                    Width="80"
                    Height="36"
                    Command="{Binding ConfirmCommand}"
                    Background="#2980b9"
                    Foreground="White"
                    BorderBrush="#2471a3"
                    BorderThickness="1"
                    Style="{StaticResource RoundedButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
